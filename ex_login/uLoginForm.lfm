        HAlign = jgdDefault
        VAlign = jgdDefault
      end    
      item
        Control = FFooterPanel
        Column = 1
        Row = 19
        ColumnSpan = 1
        HAlign = jgdCenter
        VAlign = jgdDefault
      end>
    object FTitleLabel: TLabel
