        VAlign = jgdDefault
      end    
      item
        Control = FPassEdit
        Column = 1
        Row = 11
        ColumnSpan = 1
        HAlign = jgdDefault
        VAlign = jgdDefault
      end    
      item
        Control = FRememberPanel
