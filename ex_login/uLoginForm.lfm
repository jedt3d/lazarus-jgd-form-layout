    ControlConstraints = <    
      item
        Control = FTitleLabel
        Column = 1
        Row = 1
        ColumnSpan = 3
        HAlign = jgdCenter
        VAlign = jgdDefault
      end    
      item
        Control = FSubTitleLabel
